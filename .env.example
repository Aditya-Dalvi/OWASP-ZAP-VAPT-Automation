# Copy this file to .env and replace every placeholder.
# Never commit .env or real credentials.

# ZAP installation and API
ZAP_PATH=/home/YOUR_USER/vapt_automation/tools/ZAP/zap.sh
ZAP_HOST=127.0.0.1
ZAP_PORT=8090
ZAP_API_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
ZAP_START_TIMEOUT=180

# Flask API. Keep loopback unless protected behind a trusted reverse proxy.
VAPT_API_HOST=127.0.0.1
VAPT_API_PORT=6969
VAPT_API_TOKEN=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET

# Exact hostnames are recommended. Wildcards such as *.example.test are supported.
# Use only systems for which you have written authorization.
VAPT_ALLOWED_HOSTS=app.example.test,staging.example.test
VAPT_ALLOW_PRIVATE_TARGETS=false
VAPT_ALLOW_HTTP=false

# Timeouts
SCAN_TIMEOUT_SECONDS=3600
SPIDER_TIMEOUT_SECONDS=900
AJAX_SPIDER_TIMEOUT_SECONDS=300
POLL_INTERVAL_SECONDS=5

# SMTP email reporting
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=security@example.test
SMTP_PASS=REPLACE_WITH_GMAIL_APP_PASSWORD
EMAIL_HTML_CSV=team@example.test
EMAIL_ALL_FILES=lead@example.test

# Google Chat incoming webhook (optional)
GCHAT_WEBHOOK=

# Local reports directory
REPORTS_DIR=./reports
LOG_LEVEL=INFO
